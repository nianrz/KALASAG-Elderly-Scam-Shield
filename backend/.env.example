# Copy to .env and fill in. Never commit .env.

# Any init_chat_model string. Switching providers needs no code change
# and no KB re-embedding — embeddings are local and provider-independent.
#
# We do not use a paid Anthropic API key. Bedrock serves Claude models
# (anthropic.claude-*) on AWS billing via the Accenture sandbox, which
# costs us nothing. Gemini support was removed 2026-08-06 once the sandbox
# was verified working — re-adding a provider is an `uv add` of its
# langchain package plus this env var.
#
# The sandbox region (ap-southeast-1 / Singapore) does not serve Claude
# Sonnet 5 in-region or via APAC geo-routing — only the global inference
# profile works there, hence the `global.` prefix. Using the bare
# `anthropic.claude-sonnet-5` ID from ap-southeast-1 will fail.
LLM_MODEL=bedrock_converse:global.anthropic.claude-sonnet-5

# Bounds the response. Some models count thinking against this too, so
# leave headroom or responses truncate mid-answer.
LLM_MAX_TOKENS=4096

# Below this, the Detector re-runs once with a self-reflection prompt.
# Set from the eval sweep (task T18), not asserted.
CONFIDENCE_THRESHOLD=0.70

# Seconds to back off after a 429. A full eval run is ~200 calls.
LLM_RETRY_BACKOFF=20

# Defaults to knowledge-base/out/kb.sqlite when built, else the fixture KB.
# KB_PATH=../knowledge-base/out/kb.sqlite

# --- credentials ---

# Accenture sandbox, bearer-token auth (Bedrock API keys). The _BEDROCK
# suffix is required — botocore looks for this exact name and silently
# falls through to SigV4 (then fails) if it's missing.
AWS_REGION=ap-southeast-1
AWS_BEARER_TOKEN_BEDROCK=
