# Copy to .env and fill in. Never commit .env.

# Any init_chat_model string. Switching providers needs no code change
# and no KB re-embedding — embeddings are local and provider-independent.
#   anthropic:claude-opus-5        default
#   anthropic:claude-sonnet-5      cheaper; $2/$10 per MTok intro through 2026-08-31
#   google_genai:gemini-2.5-flash  free tier
#   bedrock_converse:...           Accenture sandbox
SHIELD_MODEL=anthropic:claude-opus-5

# Bounds thinking + response text together on Claude 5. Leave headroom or
# responses truncate mid-answer.
SHIELD_MAX_TOKENS=4096

# Below this, the Detector re-runs once with a self-reflection prompt.
# Set from the eval sweep (task T18), not asserted.
SHIELD_CONFIDENCE_THRESHOLD=0.70

# Defaults to the fixture KB. Point at knowledge-base/out/kb.sqlite once
# Nian's build lands.
# SHIELD_KB_PATH=../knowledge-base/out/kb.sqlite

# Whichever key matches SHIELD_MODEL.
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
