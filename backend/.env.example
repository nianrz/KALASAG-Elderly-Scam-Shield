# Copy to .env and fill in. Never commit .env.

# Any init_chat_model string. Switching providers needs no code change
# and no KB re-embedding — embeddings are local and provider-independent.
#
#   google_genai:gemini-2.5-flash   default; free tier, no card required
#   google_genai:gemini-2.5-pro     free tier, stricter rate limit
#   bedrock_converse:...            Accenture sandbox — model list unconfirmed
#
# We do not use a paid Anthropic API key. Bedrock may still serve Claude
# models (anthropic.claude-*); that is AWS billing, not ours.
SHIELD_MODEL=google_genai:gemini-2.5-flash

# Bounds the response. Some models count thinking against this too, so
# leave headroom or responses truncate mid-answer.
SHIELD_MAX_TOKENS=4096

# Below this, the Detector re-runs once with a self-reflection prompt.
# Set from the eval sweep (task T18), not asserted.
SHIELD_CONFIDENCE_THRESHOLD=0.70

# Seconds to back off after a 429. Free tiers rate-limit aggressively and a
# full eval run is ~200 calls.
SHIELD_RETRY_BACKOFF=20

# Defaults to the fixture KB. Point at knowledge-base/out/kb.sqlite once
# Nian's build lands.
# SHIELD_KB_PATH=../knowledge-base/out/kb.sqlite

# --- credentials: fill in whichever matches SHIELD_MODEL ---

# google_genai — free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# bedrock_converse — from the Accenture sandbox
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
