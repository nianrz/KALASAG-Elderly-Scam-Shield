# Copy to .env and fill in. Never commit .env.

# Any init_chat_model string. Switching providers needs no code change
# and no KB re-embedding — embeddings are local and provider-independent.
#
#   google_genai:gemini-2.5-flash   default; free tier, no card required
#   google_genai:gemini-2.5-flash-lite  free tier, cheapest quota
#   google_genai:gemini-2.5-pro     NOT usable — free-tier quota is 0 (T1, 2026-08-06)
#   bedrock_converse:global.anthropic.claude-sonnet-5  Accenture sandbox, ap-southeast-1
#
# We do not use a paid Anthropic API key. Bedrock may still serve Claude
# models (anthropic.claude-*); that is AWS billing, not ours.
#
# The sandbox region (ap-southeast-1 / Singapore) does not serve Claude
# Sonnet 5 in-region or via APAC geo-routing — only the global inference
# profile works there, hence the `global.` prefix. Using the bare
# `anthropic.claude-sonnet-5` ID from ap-southeast-1 will fail.
LLM_MODEL=google_genai:gemini-2.5-flash

# Bounds the response. Some models count thinking against this too, so
# leave headroom or responses truncate mid-answer.
LLM_MAX_TOKENS=4096

# Below this, the Detector re-runs once with a self-reflection prompt.
# Set from the eval sweep (task T18), not asserted.
CONFIDENCE_THRESHOLD=0.70

# Seconds to back off after a 429. Free tiers rate-limit aggressively and a
# full eval run is ~200 calls.
LLM_RETRY_BACKOFF=20

# Defaults to the fixture KB. Point at knowledge-base/out/kb.sqlite once
# Nian's build lands.
# KB_PATH=../knowledge-base/out/kb.sqlite

# --- credentials: fill in whichever matches LLM_MODEL ---

# google_genai — free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# bedrock_converse — Accenture sandbox, bearer-token auth (Bedrock API keys).
# The _BEDROCK suffix is required — botocore looks for this exact name and
# silently falls through to SigV4 (then fails) if it's missing.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=ap-southeast-1

